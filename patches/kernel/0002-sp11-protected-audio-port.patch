+static void wsa884x_reset_pa_fsm(struct wsa884x_priv *wsa884x)
+{
+	regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+			   WSA884X_PA_FSM_RESET_MASK, 0);
+	regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+			   WSA884X_PA_FSM_RESET_MASK,
+			   WSA884X_PA_FSM_RESET_MASK);
+	regmap_update_bits(wsa884x->regmap, WSA884X_PA_FSM_CTL0,
+			   WSA884X_PA_FSM_RESET_MASK, 0);
+}
